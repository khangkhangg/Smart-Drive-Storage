{
  "rules": [
    {
      "id": "dev.node_modules.idle",
      "match": {
        "names": [
          "node_modules"
        ],
        "isDir": true
      },
      "conditions": {
        "requiresSiblingMarker": [
          "package.json"
        ],
        "projectIdleDays": 14
      },
      "verdict": "Safe",
      "reason": "Installed JavaScript packages. Rebuilt by running `npm install`. Project idle for 14+ days.",
      "priority": 600,
      "rebuildHint": "npm install"
    },
