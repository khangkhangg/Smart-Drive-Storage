<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Miu.App.ViewModels"
             x:Class="Miu.App.Views.ReviewView"
             x:DataType="vm:ReviewViewModel">
  <Border Width="720" MaxHeight="640" Background="{DynamicResource MiuCardBg}" CornerRadius="14" BoxShadow="0 12 40 0 #40000000" Padding="28,24">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
        <TextBlock Classes="h1" FontSize="24" Text="{Binding Title}" />
        <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" />
        <Border Background="#FDF0E1" CornerRadius="8" Padding="12,8" Margin="0,8,0,0" IsVisible="{Binding HasAttentionRows}">
          <TextBlock Foreground="#8A4600" FontSize="13" TextWrapping="Wrap"
                     Text="Some items aren't marked Safe, so they are unchecked. Tick them only if you are sure you don't need them." />
        </Border>
      </StackPanel>
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0" IsVisible="{Binding IsIdle}">
        <TextBlock Classes="muted" Text="{Binding TotalText}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="secondary" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
        <Button Grid.Column="2" Classes="primary" Content="{Binding ButtonText}" Command="{Binding CleanCommand}" Background="{StaticResource MiuSafeSolid}" />
      </Grid>
      <!-- While cleaning -->
      <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,16,0,0" IsVisible="{Binding IsWorking}">
        <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource MiuSafeSolid}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
          <Button Grid.Column="1" Classes="secondary" Content="Stop after this item" Command="{Binding StopCommand}" Margin="12,0,0,0" />
        </Grid>
        <TextBlock Classes="caption" Text="{Binding SlowText}" TextWrapping="Wrap" Foreground="{DynamicResource MiuWarnFg}"
                   IsVisible="{Binding SlowText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,12,0,0">
        <CheckBox IsChecked="{Binding BackUpFirst}" IsEnabled="{Binding CanBackUpFirst}" Content="{Binding BackUpFirstText}" IsVisible="{Binding IsIdle}" />
        <TextBlock Classes="caption" Text="{Binding BackupStatus}" TextWrapping="Wrap"
                   IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <ScrollViewer IsEnabled="{Binding IsIdle}">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReviewRow">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4">
                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="4,0,12,0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Classes="caption" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption" Text="{Binding Reason}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="2" Background="{Binding VerdictBg}" CornerRadius="9" Padding="7,1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{Binding VerdictText}" Foreground="{Binding VerdictFg}" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" MinWidth="70" TextAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
