<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Miu.App.Controls"
        x:Class="Miu.App.Views.ToastWindow"
        Title="Miu" Width="380" SizeToContent="Height" CanResize="False"
        SystemDecorations="None" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Icon="avares://Miu/Assets/miu-256.png">
  <Border Background="{DynamicResource MiuCardBg}" BorderBrush="{DynamicResource MiuBorder}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="8"
          BoxShadow="0 6 24 0 #33000000">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <c:MiuLogo Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,12,0" />
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
        <TextBlock x:Name="BodyText" FontSize="13" Foreground="{DynamicResource MiuTextSecondary}" TextWrapping="Wrap" />
        <ItemsControl x:Name="ActionsList" Margin="0,6,0,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
      <Button Grid.Column="2" Content="✕" Background="Transparent" VerticalAlignment="Top" Click="OnClose" ToolTip.Tip="Dismiss" />
    </Grid>
  </Border>
</Window>
