<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Miu.App.ViewModels"
             xmlns:c="using:Miu.App.Controls"
             x:Class="Miu.App.Views.AnalyzeView"
             x:DataType="vm:AnalyzeViewModel">
  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource MiuBorder}" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
        <TextBox Text="{Binding PathInput}" Watermark="Folder or drive to scan, e.g. C:\ or ~/code" Height="36" VerticalContentAlignment="Center" />
        <Button Grid.Column="1" Classes="secondary" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" IsEnabled="{Binding IsIdle}" />
        <Panel Grid.Column="2" Margin="8,0,0,0">
          <Button Classes="primary" Content="Scan" Command="{Binding ScanCommand}" IsVisible="{Binding IsIdle}" />
          <Button Classes="secondary" Content="Cancel" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" />
        </Panel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
          <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsScanning}" VerticalAlignment="Center" />
          <TextBlock Classes="muted" Text="{Binding ProgressText}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Breadcrumb -->
    <Border DockPanel.Dock="Top" Padding="16,8" IsVisible="{Binding HasResult}">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Command="{Binding GoUpCommand}" ToolTip.Tip="Up one level" Background="Transparent" Padding="8,4">
          <Path Data="M15,6 L9,12 L15,18" Stroke="{DynamicResource MiuText}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" />
        </Button>
        <ItemsControl ItemsSource="{Binding Breadcrumbs}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:Crumb">
              <StackPanel Orientation="Horizontal">
                <Button Content="{Binding Name}" Background="Transparent" Padding="6,4" FontSize="13"
                        Command="{Binding $parent[ItemsControl].((vm:AnalyzeViewModel)DataContext).GoToCrumbCommand}" CommandParameter="{Binding}" />
                <TextBlock Text="›" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Empty state -->
    <StackPanel IsVisible="{Binding !HasResult}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="460">
      <TextBlock Classes="h2" Text="Nothing scanned yet" HorizontalAlignment="Center" />
      <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                 Text="Type a folder above or press Browse, then Scan. Miu only reads your files — it never deletes anything without asking." />
    </StackPanel>

    <!-- Results -->
    <Grid ColumnDefinitions="2*,3*,320" IsVisible="{Binding HasResult}">
      <ListBox Classes="rows" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent"
               DoubleTapped="OnRowDoubleTapped" Margin="8,0,0,8">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Add to cleanup cart" Command="{Binding AddToCartCommand}" CommandParameter="{Binding Selected}" />
            <MenuItem Header="Open folder" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" />
            <MenuItem Header="Show in folder" Command="{Binding RevealCommand}" CommandParameter="{Binding Selected}" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:NodeItemViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
              <Path Data="{Binding Glyph}" Stroke="#B07E00" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" StrokeJoin="Round" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                <Border Background="{Binding BadgeBg}" CornerRadius="9" Padding="7,1" IsVisible="{Binding ShowsBadge}">
                  <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeFg}" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="13" MinWidth="64" TextAlignment="Right" VerticalAlignment="Center" />
              </StackPanel>
              <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="size" Value="{Binding Fraction}" Margin="0,6,0,0" Height="4" MinHeight="4" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Column="1" Margin="8,0,8,12" CornerRadius="8" ClipToBounds="True">
        <c:TreemapControl Items="{Binding Items}" SelectedItem="{Binding Selected}" OpenCommand="{Binding OpenCommand}" />
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource MiuCardBg}" BorderBrush="{DynamicResource MiuBorder}" BorderThickness="1,0,0,0" Padding="20">
        <StackPanel Spacing="16" IsVisible="{Binding HasSelection}">
          <StackPanel Spacing="4">
            <TextBlock Classes="caption" Text="{Binding Selected.FullPath}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Selected.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding Selected.KindText}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
            <TextBlock Text="{Binding Selected.SizeText}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Selected.PercentText}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Classes="caption" Text="{Binding Selected.FilesText}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" Text="of this folder" />
          </Grid>
          <TextBlock Classes="muted" Text="{Binding Selected.ModifiedText}" />
          <Border Background="{Binding Selected.VerdictBg}" CornerRadius="8" Padding="14">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding Selected.VerdictText}" Foreground="{Binding Selected.VerdictFg}" FontWeight="Bold" FontSize="14" />
              <TextBlock Text="{Binding Selected.Reason}" Foreground="#2B2B2B" FontSize="13" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Selected.RebuildText}" Foreground="#2B2B2B" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding Selected.HasRebuildHint}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Selected.RuleText}" Foreground="#5D5D5D" FontSize="11" />
            </StackPanel>
          </Border>
          <Button Classes="primary" Content="Add to cleanup cart" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding AddToCartCommand}" CommandParameter="{Binding Selected}" IsVisible="{Binding !SelectedInCart}" />
          <Button Classes="secondary" Content="Remove from cart" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding RemoveFromCartCommand}" CommandParameter="{Binding Selected}" IsVisible="{Binding SelectedInCart}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="secondary" Content="Show in folder" Command="{Binding RevealCommand}" CommandParameter="{Binding Selected}" />
            <Button Classes="secondary" Content="Copy path" Click="OnCopyPath" />
          </StackPanel>
          <Button Classes="secondary" Content="Open folder" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" IsVisible="{Binding Selected.IsDir}" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
