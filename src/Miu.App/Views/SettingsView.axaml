<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Miu.App.ViewModels"
             x:Class="Miu.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="40,32" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="Settings" />

      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="Run Miu in the background" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Start when you sign in and keep running in the tray, so automations happen on time. Closing the window keeps Miu in the tray." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding RunInBackground}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="Allow automatic cleaning" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Lets automations that you set to “clean automatically” move items marked Safe to the Recycle Bin without asking. Nothing else is ever cleaned automatically, and every clean can be undone in Activity." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowAutoClean}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="When automations may run" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Pause while on battery" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PauseOnBattery}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Quiet hours from" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding QuietStart}" IsEnabled="{Binding QuietHoursEnabled}" />
              <TextBlock Text="to" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding QuietEnd}" IsEnabled="{Binding QuietHoursEnabled}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding QuietHoursEnabled}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="secondary" Content="Pause for 1 hour" Command="{Binding PauseOneHourCommand}" />
            <Button Classes="secondary" Content="Resume" Command="{Binding ResumeAutomationsCommand}" />
            <TextBlock Classes="muted" Text="{Binding PauseText}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" DataContext="{Binding Telegram}" x:DataType="vm:TelegramSettingsViewModel">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Telegram" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Get alerts on your phone with buttons like Clean now and Snooze, and send commands such as /status. From Telegram, Miu only moves Safe items to the Recycle Bin, after you confirm, and you can undo it." />
          <StackPanel Spacing="8" IsVisible="{Binding IsNotPaired}">
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="1. In Telegram, talk to @BotFather, send /newbot and copy the token it gives you.  2. Paste it here and press Connect.  3. Send the pairing code to your bot." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding Token}" PasswordChar="•" Watermark="123456789:AA…" Width="380" />
              <Button Classes="primary" Content="Connect" Command="{Binding ConnectCommand}" />
            </StackPanel>
            <Border Background="#EEF4FB" CornerRadius="8" Padding="12,10" IsVisible="{Binding IsPairing}">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding PairingCode}" FontSize="26" FontWeight="SemiBold" LetterSpacing="4" Foreground="{StaticResource MiuAccent}" />
                <TextBlock Text="{Binding Instruction}" TextWrapping="Wrap" FontSize="13" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Spacing="8" IsVisible="{Binding IsPaired}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Send alerts to Telegram" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding SendAlerts}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="secondary" Content="Send a test message" Command="{Binding SendTestCommand}" />
              <Button Content="Unpair" Command="{Binding UnpairCommand}" Background="Transparent" Foreground="#A4262C" />
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Classes="caption" Text="{Binding Version}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
