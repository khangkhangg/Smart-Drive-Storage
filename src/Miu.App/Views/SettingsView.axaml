<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Miu.App.ViewModels"
             x:Class="Miu.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="40,32" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="Settings" />

      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="Run Miu in the background" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Start when you sign in and keep running in the tray, so automations happen on time. Closing the window keeps Miu in the tray." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding RunInBackground}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="Allow automatic cleaning" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Lets automations that you set to “clean automatically” move items marked Safe to the Recycle Bin without asking. Nothing else is ever cleaned automatically, and every clean can be undone in Activity." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowAutoClean}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="When automations may run" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Pause while on battery" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PauseOnBattery}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Quiet hours from" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding QuietStart}" IsEnabled="{Binding QuietHoursEnabled}" />
              <TextBlock Text="to" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding QuietEnd}" IsEnabled="{Binding QuietHoursEnabled}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding QuietHoursEnabled}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="secondary" Content="Pause for 1 hour" Command="{Binding PauseOneHourCommand}" />
            <Button Classes="secondary" Content="Resume" Command="{Binding ResumeAutomationsCommand}" />
            <TextBlock Classes="muted" Text="{Binding PauseText}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" DataContext="{Binding Telegram}" x:DataType="vm:TelegramSettingsViewModel">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Telegram" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Get alerts on your phone with buttons like Clean now and Snooze, and send commands such as /status. From Telegram, Miu only moves Safe items to the Recycle Bin, after you confirm, and you can undo it." />
          <StackPanel Spacing="8" IsVisible="{Binding IsNotPaired}">
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="1. In Telegram, talk to @BotFather, send /newbot and copy the token it gives you.  2. Paste it here and press Connect.  3. Send the pairing code to your bot." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding Token}" PasswordChar="•" Watermark="123456789:AA…" Width="380" />
              <Button Classes="primary" Content="Connect" Command="{Binding ConnectCommand}" />
            </StackPanel>
            <Border Background="#EEF4FB" CornerRadius="8" Padding="12,10" IsVisible="{Binding IsPairing}">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding PairingCode}" FontSize="26" FontWeight="SemiBold" LetterSpacing="4" Foreground="{StaticResource MiuAccent}" />
                <TextBlock Text="{Binding Instruction}" TextWrapping="Wrap" FontSize="13" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Spacing="8" IsVisible="{Binding IsPaired}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Send alerts to Telegram" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding SendAlerts}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="secondary" Content="Send a test message" Command="{Binding SendTestCommand}" />
              <Button Content="Unpair" Command="{Binding UnpairCommand}" Background="Transparent" Foreground="{DynamicResource MiuDangerFg}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Appearance" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Theme" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="140" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Cloud apps (your own keys)" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="To back up to Google Drive, OneDrive or Dropbox, Miu needs an “app” registered with that company. Make your own: it's free, takes about 5 minutes, and keeps working for as long as you like, with no one else's app or limits in the way. Your sign-in stays between you and the provider. S3-compatible storage (Backblaze B2, Wasabi, R2, MinIO, AWS) needs no app: just its access keys." />
          <ItemsControl ItemsSource="{Binding CloudApps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CloudAppSetupViewModel">
                <Border BorderBrush="{DynamicResource MiuBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                      <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource MiuSafeFg}" FontWeight="SemiBold" IsVisible="{Binding StatusIsGood}" />
                      <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" IsVisible="{Binding !StatusIsGood}" />
                    </Grid>
                    <Expander Header="How to get your own keys (step by step)">
                      <StackPanel Spacing="6">
                        <ItemsControl ItemsSource="{Binding Steps}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupStep">
                              <Grid ColumnDefinitions="22,*" Margin="0,3">
                                <TextBlock Text="{Binding Number, StringFormat='{}{0}.'}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Spacing="2" IsVisible="{Binding HasRedirect}">
                          <TextBlock Classes="caption" Text="Redirect address to enter:" />
                          <SelectableTextBlock Text="{Binding RedirectUri}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Classes="secondary" Content="{Binding ConsoleName, StringFormat='Open {0}'}" Command="{Binding OpenConsoleCommand}" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Expander>
                    <WrapPanel ItemSpacing="10" LineSpacing="10">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="{Binding IdLabel}" />
                        <TextBox Text="{Binding ClientId}" Watermark="{Binding IdWatermark}" Width="380" />
                      </StackPanel>
                      <StackPanel Spacing="4" IsVisible="{Binding NeedsSecret}">
                        <TextBlock Classes="caption" Text="Client secret (kept in your system's secure store)" />
                        <TextBox Text="{Binding ClientSecret}" PasswordChar="•" Watermark="GOCSPX-…" Width="260" />
                      </StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" />
                      <Button Classes="secondary" Content="Remove my keys" Command="{Binding RemoveCommand}" />
                      <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MiuDangerFg}" IsVisible="{Binding MessageIsError}" />
                      <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding !MessageIsError}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Updates" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Check for new versions once a day" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoUpdateCheck}" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="Miu only asks GitHub for the list of releases. Nothing is installed without you: you'll see a Download button." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="secondary" Content="Check now" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !IsCheckingUpdates}" />
            <TextBlock Text="{Binding UpdateStatus}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsWindows}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="h2" Text="“Analyze with Miu” in Explorer" />
              <TextBlock Classes="muted" Text="Adds it to the right-click menu of folders and drives." TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ExplorerMenu}" />
          </Grid>
          <TextBlock Classes="caption" Text="{Binding ExplorerStatus}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Your data" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="Everything Miu knows stays on this computer. Export your settings, rules, automations, sync jobs and backup plans to a file (without any passwords or keys)." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding ExportFolder}" Width="360" />
            <Button Classes="secondary" Content="Export" Command="{Binding ExportCommand}" />
            <Button Classes="secondary" Content="Open Miu's data folder" Command="{Binding OpenDataFolderCommand}" />
          </StackPanel>
          <TextBlock Classes="caption" Text="{Binding ExportStatus}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Classes="caption" Text="{Binding Version}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
