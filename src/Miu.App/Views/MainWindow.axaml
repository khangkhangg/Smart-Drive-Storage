<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Miu.App.ViewModels"
        xmlns:v="using:Miu.App.Views"
        x:Class="Miu.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Miu Smart Storage"
        Width="1360" Height="860" MinWidth="900" MinHeight="600"
        Background="{DynamicResource MiuShellBg}"
        TransparencyLevelHint="Mica, AcrylicBlur, None">
  <Grid ColumnDefinitions="232,*">
    <DockPanel Grid.Column="0" Margin="12,18,12,16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="10,0,0,20">
        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource MiuAccent}">
          <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Miu" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Smart Storage" Classes="caption" />
        </StackPanel>
      </StackPanel>
      <ListBox Classes="nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:NavItem">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Data="{Binding Icon}" Stroke="{DynamicResource MiuText}" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" StrokeLineCap="Round" StrokeJoin="Round" />
              <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <Border Grid.Column="1" Background="{DynamicResource MiuContentBg}" BorderBrush="{DynamicResource MiuBorder}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
      <ContentControl Content="{Binding CurrentPage}">
        <ContentControl.DataTemplates>
          <DataTemplate x:DataType="vm:HomeViewModel"><v:HomeView /></DataTemplate>
          <DataTemplate x:DataType="vm:AnalyzeViewModel"><v:AnalyzeView /></DataTemplate>
          <DataTemplate x:DataType="vm:DevProjectsViewModel"><v:DevProjectsView /></DataTemplate>
          <DataTemplate x:DataType="vm:PlaceholderViewModel">
            <StackPanel Margin="40,32" Spacing="8">
              <TextBlock Classes="h1" Text="{Binding Title}" />
              <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
            </StackPanel>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>
  </Grid>
</Window>
