<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Miu.App.ViewModels"
             xmlns:p="using:Miu.Platform.Portable"
             xmlns:svc="using:Miu.App.Services"
             xmlns:data="using:Miu.Data"
             x:Class="Miu.App.Views.CloudNetworkView"
             x:DataType="vm:CloudNetworkViewModel">
  <ScrollViewer>
    <StackPanel Margin="40,32" Spacing="20">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Cloud &amp; Network" />
        <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                   Text="Back up folders to the cloud, connect network drives, and keep folders in sync. Nothing is ever simply deleted: replaced or removed files are kept as older versions or set aside, and can be put back." />
      </StackPanel>

      <TabControl Name="Tabs">
        <!-- ===== Network drives ===== -->
        <TabItem Header="Network drives">
          <StackPanel Spacing="16" Margin="0,16,0,0">
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h2" Text="Find devices on my network" />
                    <TextBlock Classes="muted" Text="{Binding DevicesText}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="secondary" Content="Find devices" Command="{Binding FindDevicesCommand}"
                          IsEnabled="{Binding !IsSearching}" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Devices}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="10" LineSpacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="p:DiscoveredDevice">
                      <Button Classes="secondary" Padding="14,8" ToolTip.Tip="{Binding Via}"
                              Command="{Binding $parent[ItemsControl].((vm:CloudNetworkViewModel)DataContext).PickDeviceCommand}" CommandParameter="{Binding}">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Classes="caption" Text="{Binding Address}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="Map a network drive" />
                <TextBlock Classes="muted" Text="{Binding UnsupportedReason}" TextWrapping="Wrap" IsVisible="{Binding CannotMap}" />
                <StackPanel Spacing="12" IsVisible="{Binding CanMap}">
                  <ItemsControl ItemsSource="{Binding Shares}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Button Classes="secondary" Content="{Binding}"
                                Command="{Binding $parent[ItemsControl].((vm:CloudNetworkViewModel)DataContext).PickShareCommand}" CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <WrapPanel ItemSpacing="10" LineSpacing="10">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="caption" Text="Shared folder" />
                      <TextBox Text="{Binding UncText}" Watermark="\\nas\photos" Width="300" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Classes="caption" Text="Drive letter" />
                      <ComboBox ItemsSource="{Binding Letters}" SelectedItem="{Binding SelectedLetter}" Width="130" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Classes="caption" Text="User name (optional)" />
                      <TextBox Text="{Binding UserName}" Width="180" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Classes="caption" Text="Password" />
                      <TextBox Text="{Binding Password}" PasswordChar="●" Width="180" />
                    </StackPanel>
                  </WrapPanel>
                  <CheckBox IsChecked="{Binding Reconnect}" Content="Reconnect when I sign in (the password is kept in your system's secure store)" />
                  <Button Classes="primary" Content="Map drive" Command="{Binding MapCommand}" HorizontalAlignment="Left" />
                </StackPanel>
                <TextBlock Text="{Binding NetworkMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource MiuSafeFg}"
                           IsVisible="{Binding !NetworkMessageIsError}" />
                <TextBlock Text="{Binding NetworkMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource MiuDangerFg}"
                           IsVisible="{Binding NetworkMessageIsError}" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="Connected network drives" />
              <TextBlock Classes="muted" Text="None yet." IsVisible="{Binding !HasMapped}" />
              <ItemsControl ItemsSource="{Binding Mapped}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MappedRow">
                    <Border Classes="card" Padding="16,12" Margin="0,0,0,10">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Classes="caption" Text="{Binding Status}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <Button Classes="secondary" Content="Scan" Command="{Binding $parent[ItemsControl].((vm:CloudNetworkViewModel)DataContext).ScanMappedCommand}" CommandParameter="{Binding}" />
                          <Button Classes="secondary" Content="Disconnect" Command="{Binding $parent[ItemsControl].((vm:CloudNetworkViewModel)DataContext).UnmapCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border Classes="card" Padding="20">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Scan a network folder" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="Any folder you can open works, including \\server\share paths and shares mounted by your file manager. Network folders are scanned gently, so the NAS and your Wi-Fi stay usable." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding ScanPathText}" Watermark="\\nas\photos   or   /mnt/nas" Width="380" />
                  <Button Classes="secondary" Content="Scan" Command="{Binding ScanPathCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>

        <!-- ===== Sync jobs ===== -->
        <TabItem Header="Sync jobs">
          <StackPanel Spacing="16" Margin="0,16,0,0">
            <TextBlock Text="{Binding SyncMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource MiuSafeFg}"
                       IsVisible="{Binding !SyncMessageIsError}" />
            <TextBlock Text="{Binding SyncMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource MiuDangerFg}"
                       IsVisible="{Binding SyncMessageIsError}" />

            <!-- Preview sheet -->
            <Border Classes="card" Padding="20" IsVisible="{Binding HasPreview}" BorderBrush="{DynamicResource MiuSafeFg}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="{Binding Previewing.Name, StringFormat='Preview: {0}', FallbackValue=''}" />
                <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding PreviewOps}" MaxHeight="300">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PreviewOpRow">
                      <Grid ColumnDefinitions="150,*,Auto" Margin="0,2">
                        <TextBlock Text="{Binding Action}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Reason}" Margin="12,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="caption" Text="{Binding ProgressText}" IsVisible="{Binding IsRunning}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Run now" Command="{Binding RunPreviewCommand}" IsVisible="{Binding PreviewCanRun}" IsEnabled="{Binding !IsRunning}" />
                  <Button Classes="secondary" Content="Run anyway (everything set aside can be put back)" Command="{Binding RunAnywayCommand}"
                          IsVisible="{Binding PreviewRefused}" IsEnabled="{Binding !IsRunning}" />
                  <Button Classes="secondary" Content="{Binding IsRunning, Converter={x:Static vm:CloudNetworkConverters.CloseOrStop}}" Command="{Binding ClosePreviewCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Browse and restore -->
            <Border Classes="card" Padding="20" IsVisible="{Binding IsRestoreOpen}" BorderBrush="{DynamicResource MiuSafeFg}" BorderThickness="1">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h2" Text="{Binding RestoreTitle}" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Classes="secondary" Content="Close" Command="{Binding CloseRestoreCommand}" />
                </Grid>
                <TextBlock Classes="muted" Text="{Binding RestoreMessage}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="muted" Text="Restore to" VerticalAlignment="Center" />
                  <TextBox Text="{Binding RestoreTo}" Width="420" ToolTip.Tip="Where it came from, or any other folder" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="secondary" Content="↑ Up" Command="{Binding BackupUpCommand}" IsEnabled="{Binding CanGoUpInBackup}" />
                  <TextBlock Classes="caption" Text="{Binding RestoreLocation}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ScrollViewer MaxHeight="360">
                  <ItemsControl ItemsSource="{Binding RestoreRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BackupRow">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                          <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1">
                            <Button Classes="secondary" Padding="6,2" Content="{Binding Name}" Command="{Binding OpenCommand}" IsVisible="{Binding IsDir}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Name}" IsVisible="{Binding IsFile}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption" Text="{Binding Details}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="secondary" Content="Older versions" Command="{Binding VersionsCommand}" IsVisible="{Binding IsFile}" />
                            <Button Classes="primary" Content="Restore" Command="{Binding RestoreCommand}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <StackPanel Spacing="6" IsVisible="{Binding HasVersions}">
                  <TextBlock Text="{Binding VersionsOf, StringFormat='Versions of {0}'}" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding RestoreVersions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BackupVersionRow">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Classes="caption" Text="{Binding Details}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="secondary" Content="Restore this version" Command="{Binding RestoreCommand}" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Editor -->
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="{Binding EditorTitle}" />
                <ListBox Classes="segmented" ItemsSource="{Binding JobKinds}" SelectedItem="{Binding JobKind}" HorizontalAlignment="Left">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
                <!-- Disk image -->
                <StackPanel Spacing="12" IsVisible="{Binding IsDiskImage}">
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="A disk image is a complete copy of a drive, including Windows and your programs, so you can put the whole computer back after a disk failure. Miu uses your system's own tool (wbadmin on Windows, hdiutil on macOS, dd on Linux), asks for admin permission, and never writes to the drive being imaged." />
                  <WrapPanel ItemSpacing="10" LineSpacing="10">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="caption" Text="Drive to image" />
                      <ComboBox ItemsSource="{Binding ImageDrives}" SelectedItem="{Binding ImageSource}" Width="240" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Classes="caption" Text="Save the image on (another drive)" />
                      <ComboBox ItemsSource="{Binding ImageDrives}" SelectedItem="{Binding ImageTarget}" Width="240" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding CanUseNetworkTarget}">
                      <TextBlock Classes="caption" Text="…or a network folder (optional)" />
                      <TextBox Text="{Binding ImageNetworkTarget}" Watermark="\\nas\backups" Width="240" />
                    </StackPanel>
                  </WrapPanel>
                  <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <TextBlock Text="Repeat" VerticalAlignment="Center" Classes="muted" />
                    <ComboBox ItemsSource="{Binding ImageRepeats}" SelectedItem="{Binding ImageRepeat}" />
                    <TextBlock Text="on" VerticalAlignment="Center" IsVisible="{Binding IsImageWeekly}" />
                    <ComboBox ItemsSource="{Binding Days}" SelectedItem="{Binding ImageDay}" IsVisible="{Binding IsImageWeekly}" />
                    <TextBlock Text="on day" VerticalAlignment="Center" IsVisible="{Binding IsImageMonthly}" />
                    <ComboBox ItemsSource="{Binding DaysOfMonth}" SelectedItem="{Binding ImageDayOfMonth}" IsVisible="{Binding IsImageMonthly}" />
                    <TextBlock Text="at" VerticalAlignment="Center" IsVisible="{Binding IsImageScheduled}" />
                    <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding ImageHour}" IsVisible="{Binding IsImageScheduled}" />
                    <TextBlock Text=":00" VerticalAlignment="Center" IsVisible="{Binding IsImageScheduled}" />
                  </WrapPanel>
                  <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsImageScheduled}"
                             Text="Miu hands the schedule to your system (Task Scheduler on Windows, a systemd timer on Linux): one admin prompt now, none later, and it runs even when Miu is closed. Leave the computer on (or asleep) at that time. Windows keeps older images on the drive and removes the oldest when space runs low." />
                  <TextBlock Text="{Binding ImageMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource MiuDangerFg}" IsVisible="{Binding ImageMessageIsError}" />
                  <TextBlock Text="{Binding ImageMessage}" TextWrapping="Wrap" IsVisible="{Binding !ImageMessageIsError}" />
                  <Border Background="{DynamicResource MiuContentBg}" CornerRadius="6" Padding="12" IsVisible="{Binding HasImagePlan}">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="caption" Text="This runs:" />
                      <SelectableTextBlock Text="{Binding ImagePlan.Command.Display, FallbackValue=''}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding ImagePlan.Command.ImagePath, StringFormat='The image goes to: {0}', FallbackValue=''}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding ImagePlan.Command.RestoreHow, StringFormat='To restore later: {0}', FallbackValue=''}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <TextBlock Classes="caption" Text="{Binding ImageProgress}" IsVisible="{Binding IsImaging}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary" Content="Check" Command="{Binding CheckImageCommand}" />
                    <Button Classes="primary" Content="Make the image now" Command="{Binding MakeImageCommand}" IsVisible="{Binding IsImageOnce}" />
                    <Button Classes="primary" Content="Save schedule" Command="{Binding SaveImageScheduleCommand}" IsVisible="{Binding IsImageScheduled}" IsEnabled="{Binding !IsImaging}" />
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding HasImageSchedules}">
                    <TextBlock Text="Scheduled disk images" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ImageSchedules}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImageScheduleRow">
                          <Border BorderBrush="{DynamicResource MiuBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Classes="caption" Text="{Binding When}" />
                                <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" />
                              </StackPanel>
                              <Button Grid.Column="1" Classes="secondary" Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" VerticalAlignment="Center" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
                <StackPanel Spacing="12" IsVisible="{Binding IsSyncKind}">
                  <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsDriveBackup}"
                             Text="Copies your files from a whole drive to a folder on another drive, then only what changed. Windows, programs, swap files and caches are skipped (reinstall programs instead). Older versions of changed files are kept in the backup's .miu-sync-trash." />
                  <WrapPanel ItemSpacing="10" LineSpacing="10">
                    <StackPanel Spacing="4" IsVisible="{Binding IsFolderJob}">
                      <TextBlock Classes="caption" Text="From (source)" />
                      <TextBox Text="{Binding JobSource}" Watermark="C:\Users\you\Pictures" Width="320" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding IsDriveBackup}">
                      <TextBlock Classes="caption" Text="Drive to back up" />
                      <ComboBox ItemsSource="{Binding SourceDrives}" SelectedItem="{Binding JobSource}" Width="320" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Classes="caption" Text="{Binding TargetCaption}" />
                      <TextBox Text="{Binding JobTarget}" Watermark="{Binding TargetWatermark}" Width="320" AcceptsReturn="{Binding IsFolderJob}" TextWrapping="NoWrap" MinHeight="32" />
                    </StackPanel>
                  </WrapPanel>
                  <WrapPanel ItemSpacing="8" LineSpacing="10">
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" IsVisible="{Binding IsFolderJob}" />
                    <ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" />
                    <TextBlock Text="on" VerticalAlignment="Center" IsVisible="{Binding ShowsDay}" />
                    <ComboBox ItemsSource="{Binding Days}" SelectedItem="{Binding Day}" IsVisible="{Binding ShowsDay}" />
                    <TextBlock Text="at" VerticalAlignment="Center" IsVisible="{Binding ShowsTime}" />
                    <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding Hour}" IsVisible="{Binding ShowsTime}" />
                    <TextBlock Text=":00" VerticalAlignment="Center" IsVisible="{Binding ShowsTime}" />
                  </WrapPanel>
                  <TextBlock Classes="muted" Text="{Binding ModeHelp}" TextWrapping="Wrap" IsVisible="{Binding IsFolderJob}" />
                  <CheckBox IsChecked="{Binding KeepDeletedFiles}" IsVisible="{Binding IsDriveBackup}"
                            Content="Keep files I delete from the drive in the backup (recommended)" />
                  <CheckBox IsChecked="{Binding RunOnChange}" IsVisible="{Binding IsFolderJob}"
                            Content="Live mirror: also run about 30 seconds after files in the source change" />
                  <CheckBox IsChecked="{Binding SkipRebuildable}" Content="Skip rebuildable folders (node_modules, .venv, __pycache__, build caches)" />
                  <Expander Header="Skip these (one pattern per line)" IsExpanded="{Binding IsDriveBackup, Mode=OneWay}">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="caption" TextWrapping="Wrap"
                                 Text="A name (node_modules, *.tmp) is skipped anywhere. A path (Users/*/AppData/Local/Temp) is from the top of the source. Skipped files are never copied or set aside." />
                      <TextBox Text="{Binding JobExcludes}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="90" MaxHeight="220" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
                    </StackPanel>
                  </Expander>
                  <CheckBox IsChecked="{Binding CompareByHash}" Content="Compare file contents when dates differ (slower, avoids needless copies)" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Name" VerticalAlignment="Center" Classes="muted" />
                    <TextBox Text="{Binding JobName}" Width="260" Watermark="Photos to NAS" />
                  </StackPanel>
                  <Button Classes="primary" Content="Save and preview" Command="{Binding SaveJobCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </StackPanel>
            </Border>

            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="Your sync jobs and drive backups" />
              <TextBlock Classes="muted" Text="None yet." IsVisible="{Binding !HasJobs}" />
              <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SyncJobRow">
                    <Border Classes="card" Padding="16,12" Margin="0,0,0,10">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="" OffContent="" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Classes="caption" Text="{Binding Route}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted" Text="{Binding Details}" />
                          <TextBlock Classes="caption" Text="{Binding LastText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Button Classes="secondary" Content="Preview / Run" Command="{Binding PreviewCommand}" />
                          <Button Classes="secondary" Content="Browse &amp; restore" Command="{Binding BrowseCommand}" />
                          <Button Classes="secondary" Content="Delete" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </TabItem>

        <!-- ===== Cloud backup ===== -->
        <TabItem Header="Cloud backup">
          <StackPanel Spacing="16" Margin="0,16,0,0" DataContext="{Binding Backup}" x:DataType="vm:CloudBackupViewModel">
            <TextBlock Text="{Binding PlanMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource MiuSafeFg}" IsVisible="{Binding !PlanMessageIsError}" />
            <TextBlock Text="{Binding PlanMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource MiuDangerFg}" IsVisible="{Binding PlanMessageIsError}" />

            <!-- Preview -->
            <Border Classes="card" Padding="20" IsVisible="{Binding HasPreview}" BorderBrush="{DynamicResource MiuSafeFg}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="{Binding Previewing.Name, StringFormat='Preview: {0}', FallbackValue=''}" />
                <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding ProgressText}" IsVisible="{Binding IsRunning}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Back up now" Command="{Binding RunPreviewCommand}" IsVisible="{Binding PreviewCanRun}" IsEnabled="{Binding !IsRunning}" />
                  <Button Classes="secondary" Content="Run anyway (removed files are kept as older versions)" Command="{Binding RunAnywayCommand}" IsVisible="{Binding PreviewRefused}" IsEnabled="{Binding !IsRunning}" />
                  <Button Classes="secondary" Content="{Binding IsRunning, Converter={x:Static vm:CloudNetworkConverters.CloseOrStop}}" Command="{Binding ClosePreviewCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Restore -->
            <Border Classes="card" Padding="20" IsVisible="{Binding HasRestore}" BorderBrush="{DynamicResource MiuSafeFg}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="{Binding Restoring.Name, StringFormat='Restore from: {0}', FallbackValue=''}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding RestoreFilter}" Watermark="Search the backup" Width="320" />
                  <Button Classes="secondary" Content="Select all shown" Command="{Binding SelectAllRestoreCommand}" />
                </StackPanel>
                <TextBlock Classes="caption" Text="{Binding RestoreCountText}" />
                <ScrollViewer MaxHeight="280">
                  <ItemsControl ItemsSource="{Binding RestoreRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RestoreRow">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                          <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Classes="caption" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption" Text="{Binding Info}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <CheckBox IsChecked="{Binding RestoreToOriginal}" Content="Put them back where they were (a different file in the way is never replaced)" />
                <TextBox Text="{Binding RestoreFolder}" Watermark="…or restore into this folder" Width="420" HorizontalAlignment="Left" IsVisible="{Binding !RestoreToOriginal}" />
                <TextBlock Text="{Binding RestoreMessage}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Restore selected" Command="{Binding RunRestoreCommand}" IsEnabled="{Binding !IsRunning}" />
                  <Button Classes="secondary" Content="Close" Command="{Binding CloseRestoreCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Accounts -->
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="Cloud accounts" />
                <ItemsControl ItemsSource="{Binding AccountRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountRow">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Classes="caption" Text="{Binding Kind}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="Disconnect" Command="{Binding DisconnectCommand}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" Text="Connect where your backups should go. Miu only gets access to its own folder." />
                <ItemsControl ItemsSource="{Binding Providers}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="10" LineSpacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:CloudProviderChoice">
                      <Button Classes="secondary" Padding="14,8" ToolTip.Tip="{Binding Note}"
                              Command="{Binding $parent[ItemsControl].((vm:CloudBackupViewModel)DataContext).ConnectOAuthCommand}" CommandParameter="{Binding}">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Name, StringFormat='Connect {0}'}" FontWeight="SemiBold" />
                          <TextBlock Classes="caption" Text="{Binding Note}" MaxWidth="230" TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Expander Header="S3-compatible storage (AWS, Backblaze B2, Wasabi, Cloudflare R2, MinIO)" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <WrapPanel ItemSpacing="10" LineSpacing="10">
                      <StackPanel Spacing="4"><TextBlock Classes="caption" Text="Endpoint" /><TextBox Text="{Binding S3Endpoint}" Width="330" /></StackPanel>
                      <StackPanel Spacing="4"><TextBlock Classes="caption" Text="Region" /><TextBox Text="{Binding S3Region}" Width="140" /></StackPanel>
                      <StackPanel Spacing="4"><TextBlock Classes="caption" Text="Bucket" /><TextBox Text="{Binding S3Bucket}" Width="200" /></StackPanel>
                      <StackPanel Spacing="4"><TextBlock Classes="caption" Text="Access key ID" /><TextBox Text="{Binding S3AccessKey}" Width="220" /></StackPanel>
                      <StackPanel Spacing="4"><TextBlock Classes="caption" Text="Secret key" /><TextBox Text="{Binding S3SecretKey}" PasswordChar="●" Width="260" /></StackPanel>
                      <StackPanel Spacing="4"><TextBlock Classes="caption" Text="Name (optional)" /><TextBox Text="{Binding S3Name}" Width="200" /></StackPanel>
                    </WrapPanel>
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="Tip: create a key that can only use this one bucket. The secret key is kept in your system's secure store." />
                    <Button Classes="primary" Content="Test and connect" Command="{Binding ConnectS3Command}" IsEnabled="{Binding !IsConnecting}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Expander>
                <TextBlock Text="{Binding AccountMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource MiuSafeFg}" IsVisible="{Binding !AccountMessageIsError}" />
                <TextBlock Text="{Binding AccountMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource MiuDangerFg}" IsVisible="{Binding AccountMessageIsError}" />
              </StackPanel>
            </Border>

            <!-- Plan editor -->
            <Border Classes="card" Padding="20" IsVisible="{Binding HasAccounts}">
              <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="New backup plan" />
                <WrapPanel ItemSpacing="10" LineSpacing="10">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="caption" Text="Folders to back up (one per line)" />
                    <TextBox Text="{Binding FoldersText}" AcceptsReturn="True" Height="76" Width="380" Watermark="C:\Users\you\Pictures&#10;C:\Users\you\Documents" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="caption" Text="Account" />
                    <ComboBox ItemsSource="{Binding AccountChoices}" SelectedItem="{Binding SelectedAccount}" Width="230">
                      <ComboBox.ItemTemplate><DataTemplate x:DataType="data:CloudAccount"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="caption" Text="Cloud folder" Margin="0,6,0,0" />
                    <TextBox Text="{Binding RemoteFolder}" Width="230" />
                  </StackPanel>
                </WrapPanel>
                <WrapPanel ItemSpacing="8" LineSpacing="10">
                  <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" />
                  <TextBlock Text="for files untouched for" VerticalAlignment="Center" IsVisible="{Binding IsFreeMode}" />
                  <NumericUpDown Value="{Binding FreeAfterDays}" Minimum="7" Maximum="3650" FormatString="0" Width="110" IsVisible="{Binding IsFreeMode}" />
                  <TextBlock Text="days," VerticalAlignment="Center" IsVisible="{Binding IsFreeMode}" />
                  <ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" />
                  <TextBlock Text="on" VerticalAlignment="Center" IsVisible="{Binding ShowsDay}" />
                  <ComboBox ItemsSource="{Binding Days}" SelectedItem="{Binding Day}" IsVisible="{Binding ShowsDay}" />
                  <TextBlock Text="at" VerticalAlignment="Center" IsVisible="{Binding ShowsTime}" />
                  <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding Hour}" IsVisible="{Binding ShowsTime}" />
                  <TextBlock Text=":00" VerticalAlignment="Center" IsVisible="{Binding ShowsTime}" />
                </WrapPanel>
                <TextBlock Classes="muted" Text="{Binding ModeHelp}" TextWrapping="Wrap" />
                <WrapPanel ItemSpacing="8" LineSpacing="10">
                  <TextBlock Text="Keep" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding KeepVersions}" Minimum="1" Maximum="100" FormatString="0" Width="100" />
                  <TextBlock Text="older versions of each file · limit upload speed to" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding BandwidthKBps}" Minimum="0" Maximum="1000000" Increment="100" FormatString="0" Width="130" />
                  <TextBlock Text="KB/s (0 = no limit)" VerticalAlignment="Center" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Name" VerticalAlignment="Center" Classes="muted" />
                  <TextBox Text="{Binding PlanName}" Width="260" Watermark="Photos" />
                </StackPanel>
                <Button Classes="primary" Content="Save and preview" Command="{Binding SavePlanCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <!-- Plans -->
            <StackPanel Spacing="10" IsVisible="{Binding HasAccounts}">
              <TextBlock Classes="h2" Text="Your backups" />
              <TextBlock Classes="muted" Text="None yet." IsVisible="{Binding !HasPlans}" />
              <ItemsControl ItemsSource="{Binding Plans}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BackupPlanRow">
                    <Border Classes="card" Padding="16,12" Margin="0,0,0,10">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="" OffContent="" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Classes="caption" Text="{Binding Route}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted" Text="{Binding Details}" TextWrapping="Wrap" />
                          <TextBlock Classes="caption" Text="{Binding LastText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Button Classes="secondary" Content="Preview / Run" Command="{Binding PreviewCommand}" />
                          <Button Classes="secondary" Content="Restore" Command="{Binding RestoreCommand}" />
                          <Button Classes="secondary" Content="Delete" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
