<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Miu.App.Controls.MiuLogo">
  <!--
    Miu: a chubby, Pixar-style kitten (Miu ~ "meow") on a soft blue squircle, with a mint sparkle for "clean".
    Drawn on a 64×64 grid: round head, big glossy eyes, rosy cheeks, soft shading.
  -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="64" Height="64">
      <!-- tile -->
      <Rectangle Width="64" Height="64" RadiusX="19" RadiusY="19">
        <Rectangle.Fill>
          <RadialGradientBrush Center="30%,20%" GradientOrigin="30%,20%" RadiusX="95%" RadiusY="95%">
            <GradientStop Offset="0" Color="#6CB6FF" />
            <GradientStop Offset="0.55" Color="#2D7BEA" />
            <GradientStop Offset="1" Color="#1A4FB8" />
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <!-- soft ground shadow -->
      <Ellipse Canvas.Left="15" Canvas.Top="48.6" Width="34" Height="6" Fill="#0A2A6B" Opacity="0.22" />

      <!-- ears (rounded tips) -->
      <Path Data="M13.6,30 C11.8,21.5 12.4,13.4 15.8,11.2 C18.8,9.3 24.2,13.4 29,19.2 Z">
        <Path.Fill>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="1" Color="#E3EBFA" />
          </LinearGradientBrush>
        </Path.Fill>
      </Path>
      <Path Data="M50.4,30 C52.2,21.5 51.6,13.4 48.2,11.2 C45.2,9.3 39.8,13.4 35,19.2 Z">
        <Path.Fill>
          <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="1" Color="#E3EBFA" />
          </LinearGradientBrush>
        </Path.Fill>
      </Path>
      <Path Fill="#FFB3C7" Data="M16.9,15.4 C18.6,14.6 22.1,17.4 24.9,20.6 L18.4,25.2 C17,21.6 16.3,17.6 16.9,15.4 Z" />
      <Path Fill="#FFB3C7" Data="M47.1,15.4 C45.4,14.6 41.9,17.4 39.1,20.6 L45.6,25.2 C47,21.6 47.7,17.6 47.1,15.4 Z" />

      <!-- head: chubby and round -->
      <Path Data="M32,17.5 C44.6,17.5 53.2,25.4 53.2,35.2 C53.2,44.6 44,50.6 32,50.6 C20,50.6 10.8,44.6 10.8,35.2 C10.8,25.4 19.4,17.5 32,17.5 Z">
        <Path.Fill>
          <RadialGradientBrush Center="42%,32%" GradientOrigin="42%,32%" RadiusX="70%" RadiusY="70%">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="0.7" Color="#F4F7FF" />
            <GradientStop Offset="1" Color="#D6E1F7" />
          </RadialGradientBrush>
        </Path.Fill>
      </Path>

      <!-- rosy cheeks -->
      <Ellipse Canvas.Left="13.6" Canvas.Top="38.4" Width="8.4" Height="5" Fill="#FF8FAB" Opacity="0.55" />
      <Ellipse Canvas.Left="42" Canvas.Top="38.4" Width="8.4" Height="5" Fill="#FF8FAB" Opacity="0.55" />

      <!-- big glossy eyes -->
      <Ellipse Canvas.Left="18.2" Canvas.Top="27.6" Width="11" Height="12.4">
        <Ellipse.Fill>
          <RadialGradientBrush Center="50%,65%" GradientOrigin="50%,70%" RadiusX="60%" RadiusY="60%">
            <GradientStop Offset="0" Color="#3B4C8C" />
            <GradientStop Offset="1" Color="#0E1336" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Canvas.Left="34.8" Canvas.Top="27.6" Width="11" Height="12.4">
        <Ellipse.Fill>
          <RadialGradientBrush Center="50%,65%" GradientOrigin="50%,70%" RadiusX="60%" RadiusY="60%">
            <GradientStop Offset="0" Color="#3B4C8C" />
            <GradientStop Offset="1" Color="#0E1336" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Canvas.Left="23.2" Canvas.Top="29.2" Width="4.4" Height="4.4" Fill="#FFFFFF" />
      <Ellipse Canvas.Left="39.8" Canvas.Top="29.2" Width="4.4" Height="4.4" Fill="#FFFFFF" />
      <Ellipse Canvas.Left="20.4" Canvas.Top="35.4" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.85" />
      <Ellipse Canvas.Left="37" Canvas.Top="35.4" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.85" />

      <!-- nose + tiny "w" smile -->
      <Path Fill="#FF6F91" Data="M30.4,41 L33.6,41 C34.3,41 34.6,41.8 34.1,42.3 L32.6,43.6 C32.3,43.9 31.7,43.9 31.4,43.6 L29.9,42.3 C29.4,41.8 29.7,41 30.4,41 Z" />
      <Path Stroke="#3A2A4A" StrokeThickness="1.2" StrokeLineCap="Round"
            Data="M32,43.7 C31.6,45.3 29.6,45.6 28.7,44.4 M32,43.7 C32.4,45.3 34.4,45.6 35.3,44.4" />

      <!-- sparkle -->
      <Path Fill="#8EF5C2" Data="M55.5,4.5 C56.2,8.4 57.6,9.8 61.5,10.5 C57.6,11.2 56.2,12.6 55.5,16.5 C54.8,12.6 53.4,11.2 49.5,10.5 C53.4,9.8 54.8,8.4 55.5,4.5 Z" />
      <Ellipse Canvas.Left="50.4" Canvas.Top="15.6" Width="2.6" Height="2.6" Fill="#8EF5C2" Opacity="0.9" />
    </Canvas>
  </Viewbox>
</UserControl>
